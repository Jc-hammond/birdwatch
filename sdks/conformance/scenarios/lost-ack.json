{
  "rule": "Retry a lost acknowledgement with unchanged UUIDs and timestamps. A duplicate is a success.",
  "collector": ["loseAck", "ack"],
  "steps": [
    {
      "capture": ["a"]
    },
    "flush",
    {
      "advanceMs": 1000
    }
  ],
  "expect": {
    "requests": [
      ["a"],
      ["a"]
    ],
    "stored": ["a"],
    "outbox": [],
    "errors": 0,
    "duplicates": 1,
    "stableRetries": true
  }
}
