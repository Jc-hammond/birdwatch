{
  "name": "@birdwatch/react-native",
  "version": "0.2.0",
  "description": "Birdwatch event capture for React Native",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "react-native": "./dist/index.js",
  "peerDependencies": {
    "react-native": ">=0.83.0",
    "@react-native-async-storage/async-storage": "^2.2.0"
  }
}
