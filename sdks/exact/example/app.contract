shape Time
  epochAtZero: number
  utcOffset: number

shape ClockSample
  at: number

shape Page
  visibilityState: string

shape Saved
  id: string

shape Receipt
  accepted: number
  duplicates: number
  retryToken: number
  retryAfterMs: number
  retryAtMs: number

component App
  resource page = exactPage() as shape Page
  resource time = exactTime() as shape Time
  mutation saved as shape Saved then sync
  mutation hiddenDelivery as shape Receipt then arm
  mutation delivery as shape Receipt then arm
  mutation clockSample as shape ClockSample
  action sample
    send clockSample = sampleClock(time.epochAtZero + performanceNow())
  task sampleSends when pending(delivery)
    every(50, sample)
  state armed = 0
  state deadline = -1
  derive foregroundToken = match delivery { case some(r) => r.retryToken, case none => 0 }
  derive hiddenToken = match hiddenDelivery { case some(r) => r.retryToken, case none => 0 }
  derive latest = max(foregroundToken, hiddenToken)
  derive receipt = foregroundToken > hiddenToken ? delivery : hiddenDelivery
  action arm
    if latest > armed
      armed = latest
      deadline = match receipt { case some(r) => max(performanceNow() + r.retryAfterMs, min(performanceNow() + 300000, r.retryAtMs - time.epochAtZero)), case none => -1 }
  action retry
    if performanceNow() >= deadline and not pending(delivery)
      send delivery = replay(time.epochAtZero + performanceNow(), false, armed)
      deadline = -1
  task backoff when deadline >= 0
    every(50, retry)
  action complete
    send saved = recordCompletion("demo-user", "demo-user:onboarding-v1", time.epochAtZero + performanceNow())
  action sync
    if latest <= armed and deadline < 0 and not pending(delivery)
      send delivery = replay(time.epochAtZero + performanceNow(), false, 0)
  action hide
    if latest <= armed and deadline < 0
      send hiddenDelivery = replay(time.epochAtZero + performanceNow(), true, 0)
  task hid when page.visibilityState == "hidden"
    after(1, hide)
  task launch mount
    after(1, sync)
  task reconnect mount
    every(10000, sync)
  view
    column
      button press=complete disabled=pending(saved) testId="record"
        text "Record completion"
      if match failure(saved) { case some(f) => true, case none => false }
        text "Could not save this event."
      else if match saved { case some(r) => true, case none => false }
        text "Saved on this device" testId="saved"
      if match delivery { case some(r) => r.accepted + r.duplicates > 0, case none => false }
        text "Completion delivered" testId="received"
