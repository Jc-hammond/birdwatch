{
  "name": "@birdwatch/exact",
  "version": "0.2.0",
  "description": "Birdwatch event capture for Expo Exact",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "example"
  ],
  "dependencies": {
    "@birdwatch/sdk": "0.1.0"
  }
}
